{
  "name": "Semantius Core (Deno + PostgreSQL 18)",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/semantius-core",

  // Host-side, runs before the container is created (incl. Codespaces): enables
  // the local Postgres only when no DATABASE_URL is provided. `|| exit 0` keeps
  // creation working on Windows hosts without `sh` (then local Postgres is off
  // by default; enable it with COMPOSE_PROFILES=localdb or pgdocker/pg-cli-create.sh).
  "initializeCommand": "sh .devcontainer/select-db.sh || exit 0",

  "features": {
    "ghcr.io/devcontainers-extra/features/deno:1": {
      "version": "latest"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "denoland.vscode-deno",
        "ms-ossdata.vscode-pgsql"
      ],
      "settings": {
        "deno.enable": true,
        "deno.lint": true,
        "js/ts.preferences.includePackageJsonAutoImports": "off",
        "js/ts.suggest.autoImports": false,
        "editor.defaultFormatter": "denoland.vscode-deno",
        "[typescript]": {
          "editor.defaultFormatter": "denoland.vscode-deno"
        },
        "[javascript]": {
          "editor.defaultFormatter": "denoland.vscode-deno"
        }
      }
    }
  },
  "postCreateCommand": "deno --version",
  "remoteUser": "node"
}
