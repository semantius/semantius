{
  "name": "Semantius Core (Deno + PostgreSQL 18)",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/semantius-core",

  "features": {
    "ghcr.io/devcontainers-extra/features/deno:1": {
      "version": "latest"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "denoland.vscode-deno",
        "ms-ossdata.vscode-pgsql"
      ],
      "settings": {
        "deno.enable": true,
        "deno.lint": true,
        "js/ts.preferences.includePackageJsonAutoImports": "off",
        "js/ts.suggest.autoImports": false,
        "editor.defaultFormatter": "denoland.vscode-deno",
        "[typescript]": {
          "editor.defaultFormatter": "denoland.vscode-deno"
        },
        "[javascript]": {
          "editor.defaultFormatter": "denoland.vscode-deno"
        }
      }
    }
  },
  "postCreateCommand": "deno --version",
  "remoteUser": "node"
}
