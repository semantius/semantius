// Configuration for the bundled `idp` service (semantius-idp) — this stack's
// default OIDC/OAuth issuer. Bind-mounted READ-ONLY at /config in the container.
//
// JSONC: comments and trailing commas are allowed. Any string value may carry a
// placeholder, substituted once before validation:
//
//   ${env:NAME}            required environment variable
//   ${env:NAME:-default}   with a default, also used when NAME is empty
//   ${file:/abs/path}      file contents, one trailing newline trimmed
//   $${                    a literal "${"
//
// The environment those read comes from the `idp` service in
// ../docker-compose.yml, which fills it from ../.env.
//
// Read ONCE, at start-up: `docker compose restart idp` to apply a change (there
// is no hot reload, and SIGHUP is ignored).
//
// Only the keys this deployment actually decides are here; everything omitted
// keeps the idp's own default. The full reference is the table in
// semantius-idp/docs/configuration.md.
//
// The dokploy build (../dokploy-build.sh) EMBEDS this file into the generated
// compose as a `configs:` entry — regenerate after every change.
{
  "server": {
    // THE ISSUER. Scheme + host[:port] + the /idp mount path, no trailing slash.
    // Every absolute URL the idp emits — discovery, e-mail links, social
    // callbacks — derives from this and never from the Host header. The cookie
    // Path used to as well; since the idp's D97 it is `cookiePath` below.
    // The default matches caddy's default front door; going live, set
    // IDP_BASE_URL=https://yourdomain.com/idp in .env.
    "baseUrl": "${env:IDP_BASE_URL:-http://localhost:3000/idp}",
    "host": "0.0.0.0",
    "port": 3000,

    // The idp always sits behind this stack's caddy front door, so honour its
    // X-Forwarded-* (Caddy 2 sets them by default). `true` trusts the immediate
    // upstream only.
    "trustProxy": true,

    // Left at the default `false`, which is right for both shipped cases: an
    // https baseUrl in production, and http://localhost:3000/idp locally —
    // localhost is exempt from the https requirement. Turn it on ONLY for a
    // non-localhost http baseUrl, i.e. reaching a dev stack over a LAN IP
    // (http://192.168.x.x:3000/idp). Never on a real deployment.
    // "allowInsecureHttp": true,

    // trustedOrigins is left out on purpose: empty trusts the address each
    // request actually arrived on (its X-Forwarded-Host), which is what a
    // deployment behind a proxy whose public URL is not known here needs.

    // Session cookie scope (idp D97). Both are left at their defaults here and
    // spelled out because the defaults are the reason /gateway works.
    //
    // cookiePath defaults to "/" — the WHOLE HOST, not the /idp mount. That is
    // what lets caddy serve the gateway at the origin root: a cookie scoped to
    // /idp would not be sent to /gateway/*, and the idp treats a missing
    // session as ANONYMOUS rather than as an error, so the calls would have
    // quietly succeeded as nobody. Narrow it to "/idp" only if you want the
    // session kept off the SPA, /rest/* and /api-docs/* on this origin — and
    // then drop the /gateway route from the Caddyfile in the same change.
    // "cookiePath": "/",
    //
    // cookieDomain is unset, which makes the cookie host-only. Set it to a
    // registrable domain to share one session across its subdomains — every
    // host under it can then read and set that session, so only across hosts
    // you control.
    // "cookieDomain": "example.com",

    "shutdownTimeoutSeconds": 10
  },

  // Signs sessions AND encrypts the stored JWT signing keys. >= 32 random bytes:
  // `openssl rand -base64 48`. Rotating it logs everyone out and makes the
  // existing signing keys undecryptable — see the idp's key-rotation runbook.
  "secret": "${env:IDP_SECRET}",

  "database": {
    // Runtime traffic, through this stack's pgbouncer (transaction pooling).
    // Safe: the idp's driver disables prepared statements and schema-qualifies
    // every query.
    "url": "${env:DATABASE_URL}",

    // The direct, non-pooled endpoint — REQUIRED whenever `url` is pooled.
    // Startup, migrations, the CLI and the cleanup job hold SESSION advisory
    // locks, which do not survive a transaction-mode pooler, so this is the
    // connection that must always work.
    "directUrl": "${env:DATABASE_URL_ADMIN}",

    // Every idp table, drizzle's migration bookkeeping included, lives here.
    // Nothing is created in `public`, so nothing collides with pg_semantius.
    "schema": "idp",

    // LOAD-BEARING. `ssl` defaults to `require` for any non-localhost host, and
    // this stack's bundled Postgres speaks plain TCP inside the compose network
    // — without this the idp cannot connect at all.
    "ssl": "disable",

    "poolMax": 10,
    "connectTimeoutSeconds": 30,
    // The idp owns its schema and migrates itself on boot; there is no separate
    // migration step in this stack.
    "migrateOnBoot": true
  },

  "site": {
    "name": "Semantius",
    // What /idp/admin/* calls itself. Branding only — the TOTP issuer label, the
    // e-mails and every token claim stay on `site.name`.
    "adminTitle": "User Manager",
    "theme": "system",
    "defaultLocale": "en-US"
  },

  // No API key ⇒ DEGRADED mode: password reset, e-mail verification and every
  // notification are disabled and hidden in the UI, and
  // auth.requireEmailVerification is forced false. That is the default here and
  // it is fine for local dev, where an administrator creates the accounts. Set
  // RESEND_API_KEY in .env (and a real `from`) for anything people depend on.
  "email": {
    "resend": { "apiKey": "${env:RESEND_API_KEY:-}" },
    "from": "Semantius <idp@example.com>"
  },

  "auth": {
    // Where a completed sign-in lands when there is no OAuth continuation and no
    // validated returnTo — the first-run setup page and a direct visit to
    // /idp/login are exactly those cases. The idp's own default is "/account",
    // its profile page, which is the wrong destination here: nobody signs in to
    // this stack to look at the identity provider, they sign in to use the admin
    // SPA. An ABSOLUTE URL is supported precisely for this "the idp sits beside
    // the product" arrangement, so send them to the product's root.
    "defaultRedirect": "${env:PUBLIC_WEB_ORIGIN:-http://localhost:3000}/"
  },

  // Invite-only: administrators create users from /idp/admin. Self-registration
  // is off for both password and social sign-up — an issuer that anyone can
  // register with is exactly what replacing the public test issuer was for.
  "signUp": {
    "enabled": false,
    "requireApproval": true,
    "allowedEmailDomains": []
  },

  "jwt": {
    // PostgREST validates ES256 and RS256 only.
    "algorithm": "ES256",

    // REQUIRED. The default RFC 8707 resource, applied when a client sends no
    // `resource` parameter — it becomes the access token's `aud`. Keep it equal
    // to the issuer. pg_semantius's rbac.uid() checks `aud` only when
    // `_settings.jwt_aud` is seeded (off by default); if you seed it, seed it
    // with EXACTLY this value.
    "audience": "${env:IDP_BASE_URL:-http://localhost:3000/idp}",

    // THIS is what makes PostgREST accept the token: a static `role` claim in
    // every access token, which PostgREST reads (PGRST_JWT_ROLE_CLAIM_KEY=.role)
    // and SET ROLEs into. Without it every request falls back to `anon` and gets
    // "permission denied". A static claim belongs here and NOT in roles.jsonc —
    // that file is the per-user role catalog, emitted as the `roles` array.
    "claims": {
      "role": "authenticated"
    },
    "claimsInIdToken": false,

    "includeUserData": true,
    "rotationInterval": "90d",

    // TTL of the JWT from GET {baseUrl}/api/auth/token — the first-party session
    // exchange, and the way to mint a token for curl from an API key.
    "sessionToken": { "ttl": 3600 }
  },

  "oauth": {
    "accessTokenTtl": "15m",
    "idTokenTtl": "1h",
    "codeTtl": "60s",
    "refreshTokenTtl": "30d",
    "refreshTokenMaxLifetime": "90d",
    // A client in oauth_clients.jsonc may only reference scopes declared here.
    "scopes": ["openid", "profile", "email", "offline_access"],
    // false: a client removed from oauth_clients.jsonc is disabled and its tokens
    // revoked. true deletes its rows instead.
    "reconcile": { "prune": false }
  },

  // --- authenticating reverse proxies ---------------------------------------
  //
  // `/idp/gateway/<name>/<rest>` streams every method to `<url>/<rest>`, and
  // caddy also serves it at the short root-level `/gateway/<name>/*` (see
  // ../Caddyfile). A caller carrying `x-api-key` and no `Authorization` has the
  // key exchanged for a session JWT — the same exchange GET /idp/api/auth/token
  // performs — and the JWT injected as `Authorization: Bearer`. That is how a
  // script holding only an API key reaches PostgREST, which validates bearer
  // tokens against the JWKS. The exchange is cached for ten minutes, so a key
  // revoked elsewhere keeps working for up to that long.
  //
  // THIS BLOCK IS THE SOURCE OF TRUTH: entries are reconciled into the `gateway`
  // table on every boot, `oauth.reconcile.prune` above decides whether an entry
  // removed from here is disabled or deleted, and the file owns `enabled` too —
  // a config gateway is switched off by deleting it from this file, not on
  // /idp/admin/gateways, which shows it read-only. A row added by hand on that
  // page is marked `manual` and the sweep leaves it alone — until a config entry
  // claims the same name, which adopts that row and makes it file-owned.
  "gateways": {
    // PostgREST, over the compose network: the SERVICE NAME and the CONTAINER
    // port, which is also how caddy addresses it. Not localhost and not a
    // published host port — inside the idp container `localhost:3000` is the idp
    // ITSELF (the request loops back to the origin root, where the base-path
    // guard 307s it to /idp/...), and `localhost:3100` is nothing at all
    // (connection refused, surfaced as `bad_gateway`); 3100 is the host-side
    // publish of this very container port, reachable only from the host.
    //
    // Plain http, so a bearer token minted from a caller's API key crosses the
    // network in clear. Acceptable because that network is private to this
    // stack, but the idp cannot know that: a PRODUCTION start-up raises
    // `gateway.insecure_upstream` for any non-localhost http upstream, this one
    // included. The warning is expected here and is not a reason to put TLS
    // between two containers on the same compose network.
    //
    // `requireAuth` is left at its default of false: a call carrying no
    // credential is forwarded ANONYMOUSLY and PostgREST answers as `anon`, which
    // for most tables is 42501 permission denied. Add `"requireAuth": true` to
    // have the gateway refuse those outright instead of passing them on.
    "rest": { "url": "http://postgrest:3000" }
  },

  "admin": {
    // Holding any of these opens /idp/admin and the admin API. `admin` and
    // `user` are the built-in catalog — this stack ships no roles.jsonc, so
    // every name here must come from it.
    "adminRoles": ["admin"],
    "allowImpersonation": false,

    // /idp/admin/database, a schema explorer and SQL console over THIS stack's
    // Postgres — the same instance pg_semantius lives in, so it reads the whole
    // cluster, not just the `idp` schema. "read-only" runs every statement in a
    // READ ONLY transaction: one statement per run, 10 s timeout, 500 rows, each
    // execution audited as `database.queried`. Useful here because this stack has
    // no other SQL console (psql is not exposed) — but an administrator who can
    // run SQL reads every row at rest, password hashes and session tokens
    // included. Set "disabled" to remove the page and both endpoints; going live
    // with untrusted administrators, do. "read-write" additionally commits.
    "database": "read-only"
  },

  "apiKeys": {
    // Per-user API keys at /idp/account/api-keys, exchangeable for a JWT at
    // GET /idp/api/auth/token with an `x-api-key` header — the scripted-access
    // path, and how you get a bearer token for curl without a browser.
    "enabled": true,
    "defaultExpiresIn": "365d",
    "maxExpiresIn": "730d",
    "tokenClientId": "idp",
    "tokenTtl": 3600
  },

  "session": {
    "expiresIn": "7d",
    "updateAge": "1d",
    "cookieCacheMinutes": 5,
    "revokeOAuthTokensOnLogout": false
  },

  "twoFactor": { "enabled": true, "trustDeviceDays": 30 },

  "rateLimit": { "enabled": true, "storage": "database" },

  // `json` for anything that collects logs — `docker compose logs idp` here.
  "logging": { "level": "info", "format": "json" },
  "cleanup": { "intervalMinutes": 60 },
  "audit": { "retentionDays": 90 }
}
