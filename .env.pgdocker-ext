# Connection profile for the LOCAL pgdocker EXTENSION container (PG18 + the
# pg_semantic_platform extension baked in) — the stack driven by pgdocker/pg-ext-*.
#
# Use it per-command:        deno task <cmd> --env pgdocker-ext
# or make it the default:    cp .env.pgdocker-ext .env.local
#
# !!! THESE ARE DEFAULTS — CHANGE THEM !!!
#   - The password must match POSTGRES_PASSWORD in pgdocker/.env (shared with the
#     CLI stack; default "devpassword").
#   - The port must match POSTGRES_EXT_PORT in pgdocker/.env + docker-compose.ext.yml
#     (default 5433 — the ext stack runs alongside the CLI stack, not on 5432).
#   - The pgdocker container has NO TLS, so do NOT append ?sslmode=require here.
#
# This connects as the `postgres` DBA (password/SCRAM). Here `_core` is installed
# by the extension, so `migrate` only deploys the apps you name on top of it.
DATABASE_URL='postgresql://postgres:devpassword@localhost:5433/appdb'
