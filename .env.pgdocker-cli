# Connection profile for the LOCAL pgdocker CLI-testing container (plain PG18, no
# extension) — the stack driven by pgdocker/pg-cli-*.
#
# Use it per-command:        deno task <cmd> --env pgdocker-cli
# or make it the default:    cp .env.pgdocker-cli .env.local
#
# !!! THESE ARE DEFAULTS — CHANGE THEM !!!
#   - The password must match POSTGRES_PASSWORD in pgdocker/.env
#     (the pg-create.sh default is "devpassword"; set a real one for anything shared/exposed).
#   - host/port/database must match pgdocker/.env + pgdocker/docker-compose.yml
#     (POSTGRES_PORT / POSTGRES_DB). The CLI stack listens on 5432.
#   - The pgdocker container has NO TLS, so do NOT append ?sslmode=require here.
#
# This connects as the `postgres` DBA (password/SCRAM) — the admin door used for
# migrations and tests. Application/runtime connections use the OAuth door (bearer
# mode) or the `semantius_authenticator` door (session mode) instead.
DATABASE_URL='postgresql://postgres:devpassword@localhost:5432/appdb'

# Session-mode (DB_AUTH_MODE=session) connection for the sample apps: the app
# connects as the restricted `semantius_authenticator` role (NOSUPERUSER/
# NOINHERIT/NOBYPASSRLS), then per request does `SET LOCAL ROLE authenticated` +
# injects request.jwt.claims. NEVER point this at `postgres`/owner (that bypasses
# RLS). This file is COMMITTED, so do NOT put a real password here — leave the
# placeholder and set the real value in a gitignored file (the sample's .env.local
# or pgdocker/.env). The local dev password lives in pgdocker/.env
# (SEMANTIUS_AUTHENTICATOR_PASSWORD; default "devpassword" — never reuse on
# anything shared/exposed). No TLS on localhost, so no ?sslmode=require.
# SEMANTIUS_AUTHENTICATOR_URL='postgresql://semantius_authenticator:<set-me>@localhost:5432/appdb'
