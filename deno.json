{
  "workspace": ["packages/core", "packages/cli"],
  "compilerOptions": {
    "lib": ["deno.window", "deno.ns"],
    "strict": true
  },
  "tasks": {
    "start": "deno run --allow-read --allow-write --allow-env --allow-net packages/cli/cli.ts",
    "init": "deno run --allow-read --allow-write --allow-env packages/cli/cli.ts init",
    "build": "deno run --allow-read --allow-write --allow-env packages/cli/cli.ts build",
    "connect": "deno run --allow-read --allow-write --allow-env --allow-net packages/cli/cli.ts connect",
    "test": "deno run --allow-read --allow-write --allow-env --allow-net packages/cli/cli.ts test",
    "lint": "deno run --allow-read --allow-write --allow-env packages/cli/cli.ts lint",
    "fmt": "deno run --allow-read --allow-write --allow-env packages/cli/cli.ts format",
    "migrate": "deno run --allow-read --allow-write --allow-env --allow-net packages/cli/cli.ts migrate",
    "extension": "deno run --allow-read --allow-write --allow-env packages/cli/cli.ts extension",
    "dropall": "deno run --allow-read --allow-write --allow-env --allow-net packages/cli/cli.ts dropall",
    "reset": "deno run --allow-read --allow-write --allow-env --allow-net packages/cli/cli.ts reset",
    "retest": "deno run --allow-read --allow-write --allow-env --allow-net packages/cli/cli.ts retest",
    "docgen": "deno run --allow-read --allow-write --allow-env --allow-net packages/cli/cli.ts docgen",
    "testgen_jsonlogic": "deno run --allow-read --allow-write --allow-env packages/cli/cli.ts testgen_jsonlogic",
    "check": "deno check packages/cli/cli.ts",
    "bundle-sql": "deno run --allow-read --allow-write scripts/bundle-sql.ts"
  },
  "fmt": {
    "files": {
      "include": ["**/*.ts", "**/*.js", "**/*.json"]
    }
  },
  "lint": {
    "files": {
      "include": ["**/*.ts", "**/*.js"]
    }
  }
}
