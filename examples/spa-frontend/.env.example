# =============================================================================
# Copy to `.env`. ALL values here are PUBLIC (VITE_ vars are inlined into the
# browser bundle) — there is NO client secret in a public OAuth client (PKCE).
# =============================================================================

# OAuth issuer (informational; same as the Next sample).
VITE_OAUTH_ISSUER=https://oidc-test.semanti.us

# PUBLIC client (no secret). NOT `test-client` (that one is confidential and only
# used by the headless /getaccesstoken mint).
VITE_OAUTH_CLIENT_ID=public-client

# react-oauth2-code-pkce uses EXPLICIT endpoints (it does no OIDC discovery — which
# also sidesteps the issuer omitting `code_challenge_methods_supported`; the lib
# always sends PKCE S256). From the issuer's discovery doc:
VITE_OAUTH_AUTHORIZATION_ENDPOINT=https://oidc-test.semanti.us/authorize
VITE_OAUTH_TOKEN_ENDPOINT=https://oidc-test.semanti.us/token

# Must be issuer-allow-listed. Confirmed allow-listed on the test issuer:
# /oauth2_callback and /auth/oauth2_callback on http://localhost:3000.
VITE_OAUTH_REDIRECT_URI=http://localhost:3000/oauth2_callback

# The standalone Hono API. 8788 (NOT 8787 — that's the oauth-hono-mcp sibling).
VITE_API_BASE_URL=http://localhost:8788
