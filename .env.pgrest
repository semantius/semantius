# Connection profile for the LOCAL self-hosted stack (PG18 + the pg_semantius
# extension, fronted by PostgREST + a Scalar docs site) — the stack itself lives
# in github.com/semantius/semantius-self-hosted.
#
# Use it per-command:        deno task <cmd> --env pgrest
# or make it the default:    cp .env.pgrest .env.local
#
# !!! THESE ARE DEFAULTS — CHANGE THEM !!!
#   - The password must match POSTGRES_PASSWORD in the stack's .env (default "postgres").
#   - The port must match POSTGRES_PORT in the stack's .env + its docker-compose.yml
#     (default 5434 — the stack runs alongside pgdocker cli/ext, not on 5432).
#   - The Postgres container has NO TLS, so do NOT append ?sslmode=require here.
#
# This connects as the `postgres` DBA (password/SCRAM). Here `_core` is installed
# by the extension, so `migrate` only deploys the apps you name on top of it. After
# each migration the CLI fires NOTIFY pgrst 'reload schema', which the running
# PostgREST picks up automatically.
DATABASE_URL='postgresql://postgres:postgres@localhost:5434/semantius'

# Session-mode connection for the sample apps: the app connects as the restricted
# `semantius_authenticator` role, then per request does `SET LOCAL ROLE authenticated`
# + injects request.jwt.claims. NEVER point this at `postgres`/owner (that bypasses
# RLS). This file is COMMITTED, so do NOT put a real password here — leave the
# placeholder and set the real value in a gitignored file (the stack's .env holds
# the local dev password, SEMANTIUS_AUTHENTICATOR_PASSWORD; "devpassword").
# No TLS on localhost, so no ?sslmode=require.
# SEMANTIUS_AUTHENTICATOR_URL='postgresql://semantius_authenticator:<set-me>@localhost:5434/semantius'
