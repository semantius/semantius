# Copy to .env and edit.

# Password for the `postgres` full-DBA login (used by DATABASE_URL / the CLI).
# Dev default; change it for anything shared or network-exposed.
POSTGRES_PASSWORD=devpassword

# Database the server creates and migrations deploy into.
POSTGRES_DB=appdb

# Host port to publish Postgres on.
POSTGRES_PORT=5432

# Validator commit to compile (pinned for reproducible builds). Rarely changed.
# OIDC_VALIDATOR_REF=72a35e90e4297221142e1d6b1dd3bcf5fabbe3fc

# The OIDC issuer + scope live in conf/pg_hba.conf (Postgres does not expand
# env vars there). Edit that file to point at a different issuer.
#
# After `docker compose up`, the full-DBA connection string is:
#   DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}
