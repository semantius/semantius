# Copy to .env and edit. Used by pgrest/docker-compose.yml (the PostgREST stack).

# Password for the `postgres` full-DBA login (used by DATABASE_URL / the CLI).
# Dev default; change it for anything shared or network-exposed.
POSTGRES_PASSWORD=postgres

# Database the server creates and migrations deploy into.
POSTGRES_DB=appdb

# Host port to publish Postgres on. 5432=pgdocker CLI, 5433=pgdocker ext,
# 5434=this PostgREST stack (so all three run side by side).
POSTGRES_PORT=5434

# Version tag of the Semantius DB image (ghcr.io/adenin-platform/semantius-db)
# to run. Built + published from ../docker-semantius. Locally, running
# docker-semantius/build.sh tags :latest so `up` uses your local build. Pin this
# to a released version (e.g. 0.2.0) for reproducible/server deploys.
SEMANTIUS_DB_VERSION=latest

# Password for `semantius_authenticator` — the role PostgREST logs in as. It is
# NOSUPERUSER/NOINHERIT and can only SET ROLE authenticated / anon. Read by
# init/11-session-role.sh AND passed to PostgREST (PGRST_DB_URI) — keep the two in
# sync. Dev default; change it for anything shared or exposed. Per-environment secret.
SEMANTIUS_AUTHENTICATOR_PASSWORD=devpassword

# Host port for the PostgREST HTTP API (the OpenAPI spec is served at its root `/`).
POSTGREST_PORT=3000

# Host port for the Scalar API-reference docs site.
DOCS_PORT=8080

# Host port for the admin SPA (ghcr.io/intranetfactory/semantius-web, serves on 80).
WEB_PORT=7070

# Browser-reachable base URL of the PostgREST API. Used for BOTH the OpenAPI spec's
# advertised server (PGRST_OPENAPI_SERVER_PROXY_URI) and the Scalar docs' spec `url`
# — both are resolved by the browser, so this must NEVER be the in-network
# `postgrest` hostname. Leave unset for local dev (defaults to
# http://localhost:${POSTGREST_PORT}). Behind a reverse proxy that maps PostgREST to
# a path prefix, set the PUBLIC URL INCLUDING that prefix, e.g.
#   PUBLIC_API_URL=https://yourdomain.com/api
# PostgREST serves at root, so the proxy MUST strip the prefix before forwarding
# (nginx `proxy_pass http://postgrest:3000/;` with trailing slash, Traefik
# StripPrefix, or Caddy `handle_path /api/*`). No trailing slash here.
# PUBLIC_API_URL=https://yourdomain.com/api

# OIDC issuer + its JWKS endpoint. PostgREST CANNOT fetch a JWKS URL, so the stack
# fetches JWKS_URL ONCE at startup (the jwks-fetch service) into a file PostgREST
# reads. If the issuer rotates keys, restart the stack (see README: JWKS rotation).
# ISSUER is used by the test script (token minting) and the docs title.
#
# !!! TEST ISSUER ONLY — a public throwaway OIDC server that mints tokens for
#     anyone. Point these at your own trusted issuer before deploying anything. !!!
ISSUER=https://oidc-test.semanti.us
JWKS_URL=https://oidc-test.semanti.us/jwks

# After `docker compose up`, the full-DBA connection string is:
#   DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}
