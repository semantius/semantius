# Connection profile for the LOCAL pgdocker PostgreSQL container.
#
# Use it per-command:        deno task <cmd> --env pgdocker
# or make it the default:    cp .env.pgdocker .env.local
#
# !!! THESE ARE DEFAULTS — CHANGE THEM !!!
#   - The password must match POSTGRES_PASSWORD in pgdocker/.env
#     (the pg-create.sh default is "devpassword"; set a real one for anything shared/exposed).
#   - host/port/database must match pgdocker/.env + pgdocker/docker-compose.yml
#     (POSTGRES_PORT / POSTGRES_DB).
#   - The pgdocker container has NO TLS, so do NOT append ?sslmode=require here.
#
# This connects as the `postgres` DBA (password/SCRAM) — the admin door used for
# migrations and tests. Application/runtime connections use the OAuth door instead.
DATABASE_URL='postgresql://postgres:devpassword@localhost:5432/appdb'
