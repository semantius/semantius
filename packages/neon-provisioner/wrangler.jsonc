{
  "name": "semantius-neon-provisioner",
  "workers_dev": true,
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "capi.semantius.cloud/*",
      "zone_name": "semantius.cloud"
    }
  ],
  // Set secrets via wrangler secret or environment variables
  // wrangler secret put NEON_API_KEY
  // wrangler secret put NEON_API_KEY_FREE       // used when a request sets is_free_plan: true
  // wrangler secret put NEON_PROVISIONER_API_KEY
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}