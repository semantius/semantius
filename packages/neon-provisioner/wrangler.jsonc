{
  "name": "semantius-neon-provisioner",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  // Set DATABASE_URL, NEON_API_KEY, and NEON_PROVISIONER_API_KEY via wrangler secret or environment variables
  // wrangler secret put DATABASE_URL
  // wrangler secret put NEON_API_KEY
  // wrangler secret put NEON_PROVISIONER_API_KEY
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
