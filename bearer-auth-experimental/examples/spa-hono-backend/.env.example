# =============================================================================
# Copy to `.env` and fill in. `.env` is gitignored — NEVER commit a real
# semantius_authenticator password or any token.
#
# DB_AUTH_MODE selects HOW the DB connection authenticates, NOT the host:
#   bearer  = PostgreSQL 18 native OAuth. The end-user's token (forwarded from the
#             SPA as `Authorization: Bearer`) authenticates the connection via SASL
#             OAUTHBEARER and the DB validates the RS256 signature. Self-host / local.
#   session = connect as the restricted role `semantius_authenticator` and inject
#             the APP-verified claims. Neon, Supabase, and local pgdocker.
# =============================================================================

DB_AUTH_MODE=bearer

# This API listens here. NOT 8787 (the oauth-hono-mcp sibling dev server uses 8787).
PORT=8788

# Exact-match CORS allowlist (comma-separated). The SPA dev origin. Never '*'.
CORS_ORIGINS=http://localhost:3000

# --- OAuth verification (session mode only; bearer lets the DB validate) ---
# These three are REQUIRED in session mode (jose verify: RS256 pinned + iss + aud,
# fail-closed). Harmless in bearer mode.
OAUTH_ISSUER=https://oidc-test.semanti.us
OAUTH_JWKS_URI=https://oidc-test.semanti.us/jwks
# The test issuer puts the client_id in `aud`; the SPA uses public-client.
OAUTH_EXPECTED_AUD=public-client

# --- bearer mode (the forwarded token authenticates the connection) ---
PG_HOST=localhost
PG_PORT=5432          # 5433 for the extension stack
PG_DATABASE=appdb

# --- session mode (connect as semantius_authenticator; app injects verified claims) ---
# pw from a gitignored source, never committed. local: no sslmode.
#   Supabase (port 6543, transaction pooler) & Neon (pooled): add ?sslmode=require
#   node-postgres is transaction-pooler-safe by default (unnamed statements) — no prepare flag.
DATABASE_URL=postgresql://semantius_authenticator:devpassword@localhost:5432/appdb
