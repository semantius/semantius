# =============================================================================
# Copy to `.env.local` and fill in. `.env.local` is gitignored — NEVER commit a
# real semantius_authenticator password or any token.
# =============================================================================

# --- Adapter selection (selects HOW the DB connection authenticates; NOT the host) ---
#   bearer  = PostgreSQL 18 native OAuth (the end-user's token authenticates the
#             connection via SASL OAUTHBEARER; the DB validates the RS256 signature).
#             Backends: self-hosted PG18 / local pgdocker.
#   session = connect as a shared restricted role (semantius_authenticator) and
#             inject the app-verified claims. Backends: Neon, Supabase, local pgdocker.
DB_AUTH_MODE=bearer

# --- OAuth (shared by both modes; the test issuer mints role=authenticated) ---
OAUTH_ISSUER=https://oidc-test.semanti.us
# Public, no-secret client (auth-code + PKCE). NOT `test-client` (that one is
# confidential and /token rejects it without a secret).
OAUTH_CLIENT_ID=public-client
# Must be allow-listed by the issuer. Confirmed allow-listed paths on the test
# issuer: /oauth2_callback and /auth/oauth2_callback (arbitrary paths are rejected).
OAUTH_REDIRECT_URI=http://localhost:3000/oauth2_callback

# --- bearer mode (token authenticates the connection) ---
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=appdb

# --- session mode (connect as semantius_authenticator; app injects verified claims) ---
# pw from a gitignored source, never committed. local: no sslmode.
#   Supabase (port 6543, transaction pooler) & Neon (pooled): add ?sslmode=require
#   node-postgres is transaction-pooler-safe by default (unnamed statements) — no prepare flag.
DATABASE_URL=postgresql://semantius_authenticator:devpassword@localhost:5432/appdb
# App-side JWT verification (MANDATORY in session mode). Defaults derive from
# OAUTH_ISSUER discovery if omitted, but pin them explicitly in production.
OAUTH_JWKS_URI=https://oidc-test.semanti.us/jwks
# Expected audience. The test issuer puts the client_id in `aud`; verification is
# mandatory in session mode (a same-issuer token for another client must be rejected).
OAUTH_EXPECTED_AUD=public-client
