# PostgreSQL connection URL (required for all CLI commands and TriggerDev)
DATABASE_URL=postgresql://username:password@host:5432/database?sslmode=require

# TriggerDev - required when using @semantius/triggerdev
# Find these in your TriggerDev project settings → API keys
# TRIGGER_SECRET_KEY=tr_dev_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TRIGGER_PROJECT_ID=proj_xxxxxxxxxxxxxxxx
